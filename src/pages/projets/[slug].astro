---
import Base from "../../layouts/Base.astro";
import { etudes, pagesProjet, sansAccents } from "../../data/projets";

// Une page par projet (projets principaux + autres travaux), générée à partir de src/data/projets.ts
export function getStaticPaths() {
  return pagesProjet.map((etude, index) => ({
    params: { slug: etude.slug },
    props: { index },
  }));
}

const { index } = Astro.props;
const etude = pagesProjet[index];
const suivante = pagesProjet[(index + 1) % pagesProjet.length];
const estTravail = index >= etudes.length; // page venant de « Autres travaux »

const parties = [
  { titre: "Contexte", texte: etude.contexte },
  { titre: "Mon rôle", texte: etude.role },
  { titre: "Processus", texte: etude.processus },
  { titre: "Choix techniques", texte: etude.techniques },
  { titre: "Résultat", texte: etude.resultat },
];

// Découpe un texte pour surligner les passages [entre crochets] encore à écrire
const morceaux = (texte: string) => texte.split(/(\[[^\]]+\])/).filter(Boolean);
---

<Base titre={`${etude.titre} · Projet · Adam Gosmat`} description={etude.resume}>
  <div class="mx-auto max-w-6xl px-5">
    <header class="flex min-h-20 flex-wrap items-center justify-between gap-4 py-4">
      <a href={estTravail ? "/#travaux" : "/#etudes"} class="grid size-12 place-items-center rounded-full border-3 border-encre bg-c1 font-black shadow-dur-sm" aria-label={estTravail ? "Retour aux autres travaux" : "Retour aux projets"}>AG</a>

      <!-- Menu pour choisir un projet -->
      <nav aria-label="Choisir un projet">
        <ul class="flex flex-wrap items-center gap-3">
          {
            etudes.map((e, i) => (
              <li>
                <a href={`/projets/${e.slug}/`} aria-current={i === index ? "page" : undefined} class={`etiquette ${i === index ? "bg-encre text-fond" : "bg-white"}`}>
                  {String(i + 1).padStart(2, "0")} · {e.titre}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="contenu">
      <p class={`etiquette mt-6 ${etude.couleur}`}>Projet {String(index + 1).padStart(2, "0")} / {String(pagesProjet.length).padStart(2, "0")}</p>
      <h1 class="my-6 font-titre text-[clamp(3rem,9vw,9rem)] leading-[0.9] text-balance uppercase">{sansAccents(etude.titre)}</h1>

      <dl class="mb-10 grid grid-cols-2 gap-3 md:grid-cols-4">
        <div class="boite bg-white p-3"><dt class="font-mono text-xs uppercase">Catégorie</dt><dd class="font-bold">{etude.categorie}</dd></div>
        <div class="boite bg-c3 p-3"><dt class="font-mono text-xs uppercase">Outils</dt><dd class="font-bold">{etude.tags.join(", ")}</dd></div>
        <div class="boite bg-c4 p-3"><dt class="font-mono text-xs uppercase">Année</dt><dd class="font-bold">{etude.annee}</dd></div>
        <div class="boite bg-c1 p-3"><dt class="font-mono text-xs uppercase">Cadre</dt><dd class="brouillon font-bold">[Perso, cours ou client ?]</dd></div>
      </dl>

      <div class="boite relative h-[min(70vh,640px)] overflow-hidden bg-c3">
        {
          etude.modele ? (
            <model-viewer src={etude.modele} alt={`${etude.titre}, modèle 3D animé`} camera-controls autoplay auto-rotate shadow-intensity="1" interaction-prompt="none" class="size-full"></model-viewer>
          ) : (
            <img src={etude.image} alt={etude.titre} class="size-full object-cover" />
          )
        }
        {etude.modele && <span class="etiquette absolute bottom-4 left-4 bg-white">Glisser pour tourner</span>}
      </div>

      <div class="mt-20 grid gap-6">
        {
          parties.map((partie) => (
            <section class="boite grid items-center gap-4 bg-white p-6 md:grid-cols-[1fr_2.2fr]">
              <h2 class="text-2xl font-black uppercase">{partie.titre}</h2>
              <p class="max-w-[62ch] text-lg">
                {morceaux(partie.texte).map((m) => (m.startsWith("[") ? <mark class="brouillon">{m}</mark> : m))}
              </p>
            </section>
          ))
        }
      </div>

      <a href={`/projets/${suivante.slug}/`} class="boite mt-10 flex flex-wrap items-center justify-between gap-4 bg-c1 p-6 transition hover:translate-0.5 hover:shadow-dur-sm">
        <span class="font-mono text-xs uppercase">Étude suivante</span>
        <span class="font-titre text-[clamp(2rem,6vw,5rem)] leading-none uppercase">{sansAccents(suivante.titre)} →</span>
      </a>
    </main>
  </div>
</Base>

<script>
  if (document.querySelector("model-viewer")) import("@google/model-viewer");
</script>
