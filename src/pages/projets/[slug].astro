---
import Base from "../../layouts/Base.astro";
import { etudes, pagesProjet, sansAccents } from "../../data/projets";

export function getStaticPaths() {
  return pagesProjet.map((etude, index) => ({
    params: { slug: etude.slug },
    props: { index },
  }));
}

const { index } = Astro.props;
const etude = pagesProjet[index];
const suivante = pagesProjet[(index + 1) % pagesProjet.length];
const estTravail = index >= etudes.length; // vient de « Autres travaux »

const parties = [
  { titre: "Contexte", texte: etude.contexte },
  { titre: "Mon rôle", texte: etude.role },
  { titre: "Processus", texte: etude.processus },
  { titre: "Choix techniques", texte: etude.techniques },
  { titre: "Résultat", texte: etude.resultat },
];

// Isole les [brouillons] pour les surligner
const morceaux = (texte: string) => texte.split(/(\[[^\]]+\])/).filter(Boolean);
---

<Base titre={`${etude.titre} · Projet · Adam Gosmat`} description={etude.resume}>
  <div class="mx-auto max-w-6xl px-5">
    <header class="flex min-h-20 flex-wrap items-center justify-between gap-4 py-4">
      <a href={estTravail ? "/#travaux" : "/#etudes"} class="grid size-12 place-items-center rounded-full border-3 border-encre bg-c1 font-black shadow-dur-sm" aria-label={estTravail ? "Retour aux autres travaux" : "Retour aux projets"}>AG</a>

      <nav aria-label="Choisir un projet">
        <ul class="flex flex-wrap items-center gap-3">
          {
            etudes.map((e, i) => (
              <li>
                <a href={`/projets/${e.slug}/`} aria-current={i === index ? "page" : undefined} class={`etiquette ${i === index ? "bg-encre text-fond" : "bg-white"}`}>
                  {String(i + 1).padStart(2, "0")} · {e.titre}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="contenu">
      <h1 class="mt-6 mb-6 font-titre text-[clamp(3rem,9vw,9rem)] leading-[0.9] text-balance uppercase">{sansAccents(etude.titre)}</h1>

      <dl class="mb-10 grid grid-cols-2 gap-3 md:grid-cols-4">
        <div class="boite bg-white p-3"><dt class="font-mono text-xs uppercase">Catégorie</dt><dd class="font-bold">{etude.categorie}</dd></div>
        <div class="boite bg-c3 p-3"><dt class="font-mono text-xs uppercase">Outils</dt><dd class="font-bold">{etude.tags.join(", ")}</dd></div>
        <div class="boite bg-c4 p-3"><dt class="font-mono text-xs uppercase">Année</dt><dd class="font-bold">{etude.annee}</dd></div>
        <div class="boite bg-c1 p-3"><dt class="font-mono text-xs uppercase">Cadre</dt><dd class="font-bold">{etude.cadre}</dd></div>
      </dl>

      {
        etude.galerie && etude.galerie.length > 0 ? (
          <section class="carrousel" aria-roledescription="carrousel" aria-label={`Captures de ${etude.titre}`}>
            <div class="boite relative overflow-hidden bg-c3">
              <ul class="carrousel-piste flex snap-x snap-mandatory overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" tabindex="0" aria-label="Captures, défiler horizontalement">
                {etude.galerie.map((vue, i) => (
                  <li class="w-full shrink-0 snap-center" aria-roledescription="diapositive" aria-label={`${i + 1} sur ${etude.galerie!.length}`}>
                    <img src={vue.src} alt={vue.alt} loading="eager" data-zoom class="aspect-[1382/868] w-full cursor-zoom-in object-cover" />
                  </li>
                ))}
              </ul>
              <button type="button" class="carrousel-prec etiquette absolute top-1/2 left-3 -translate-y-1/2 bg-white" aria-label="Capture précédente">←</button>
              <button type="button" class="carrousel-suiv etiquette absolute top-1/2 right-3 -translate-y-1/2 bg-white" aria-label="Capture suivante">→</button>
            </div>
            <div class="mt-4 flex flex-wrap items-center justify-center gap-3">
              <div class="flex gap-2" role="group" aria-label="Choisir une capture">
                {etude.galerie.map((vue, i) => (
                  <button type="button" class="carrousel-point size-4 rounded-full border-3 border-encre bg-white aria-[current=true]:bg-encre" aria-label={`Capture ${i + 1}`} aria-current={i === 0 ? "true" : "false"} />
                ))}
              </div>
            </div>
          </section>
        ) : (
      <div data-lenis-prevent data-verrou={etude.iframe || etude.modele ? "" : undefined} class="boite relative h-[min(70vh,640px)] overflow-hidden overscroll-contain bg-c3">
        {
          etude.iframe ? (
            <iframe src={etude.iframe} title={`Site ${etude.titre}`} loading="lazy" class="size-full border-0 bg-white"></iframe>
          ) : etude.modele ? (
            <model-viewer src={etude.modele} alt={`${etude.titre}, modèle 3D animé`} camera-controls autoplay auto-rotate shadow-intensity="1" interaction-prompt="none" class="size-full"></model-viewer>
          ) : (
            <img src={etude.image} alt={etude.titre} data-zoom class="size-full cursor-zoom-in object-cover" />
          )
        }
        {etude.modele && <span class="etiquette absolute bottom-4 left-4 bg-white">Glisser pour tourner</span>}
        {etude.iframe && <a href={etude.iframe} target="_blank" rel="noopener" class="etiquette absolute right-4 bottom-4 bg-white">Ouvrir le site ↗</a>}
      </div>
        )
      }

      <div class="mt-20 grid gap-4">
        {
          parties.map((partie) => (
            <section tabindex="0" role="button" aria-expanded="false" class="partie boite group cursor-pointer bg-white p-6 outline-none transition hover:-translate-y-0.5 focus-visible:-translate-y-0.5">
              <h2 class="text-2xl font-black uppercase md:text-4xl">
                {partie.titre}
              </h2>
              <!-- 0fr → 1fr anime une hauteur auto -->
              <div class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out motion-reduce:transition-none group-aria-expanded:grid-rows-[1fr]">
                <div class="overflow-hidden">
                  <p class="pt-4 text-lg">
                    {morceaux(partie.texte).map((m) => (m.startsWith("[") ? <mark class="brouillon">{m}</mark> : m))}
                  </p>
                </div>
              </div>
            </section>
          ))
        }
      </div>

      <a href={`/projets/${suivante.slug}/`} class="boite mt-10 flex flex-wrap items-center justify-between gap-4 bg-c1 p-6 transition hover:translate-0.5 hover:shadow-dur-sm">
        <span class="font-mono text-xs uppercase">Étude suivante</span>
        <span class="font-titre text-[clamp(2rem,6vw,5rem)] leading-none uppercase">{sansAccents(suivante.titre)} →</span>
      </a>
    </main>
  </div>
  <!-- Aperçu agrandi : clic sur une image. Clic dehors ou Échap = ferme (popover auto) -->
  <div id="apercu-fenetre" popover>
    <div class="boite inline-flex flex-col overflow-hidden bg-c5">
      <div class="grid h-12 shrink-0 grid-cols-[1fr_auto_1fr] items-center gap-3 border-b-3 border-encre bg-fond px-3">
        <div class="group/feux flex items-center gap-2">
          <button type="button" popovertarget="apercu-fenetre" popovertargetaction="hide" class="grid size-5 place-items-center rounded-full border-2 border-encre bg-c2" aria-label="Fermer"><span class="text-sm leading-none font-black opacity-0 group-hover/feux:opacity-100" aria-hidden="true">×</span></button>
          <span class="grid size-5 place-items-center rounded-full border-2 border-encre bg-c1" aria-hidden="true"><span class="text-sm leading-none font-black opacity-0 group-hover/feux:opacity-100">−</span></span>
          <span class="grid size-5 place-items-center rounded-full border-2 border-encre bg-c4" aria-hidden="true"><svg viewBox="0 0 10 10" class="size-2.5 opacity-0 group-hover/feux:opacity-100" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 2 1 5l3 3M6 2l3 3-3 3"/></svg></span>
        </div>
        <p id="apercu-titre" class="min-w-0 truncate font-mono text-xs uppercase">{sansAccents(etude.titre)}</p>
        <span aria-hidden="true"></span>
      </div>
      <img id="apercu-img" src="" alt="" class="block object-contain" />
    </div>
  </div>
</Base>

<script>
  // Souris sur iframe/3D : Lenis en pause, la page ne défile pas
  const racine = document.documentElement;
  const lenis = () => (window as any).lenis;
  document.querySelectorAll<HTMLElement>("[data-verrou]").forEach((zone) => {
    zone.addEventListener("pointerenter", (e) => {
      if (e.pointerType !== "mouse") return;
      lenis()?.stop();
      racine.style.scrollbarGutter = "stable"; // évite le saut de mise en page
      racine.style.overflow = "hidden";
    });
    zone.addEventListener("pointerleave", () => {
      lenis()?.start();
      racine.style.overflow = "";
      racine.style.scrollbarGutter = "";
    });
    zone.addEventListener("wheel", (e) => e.preventDefault(), { passive: false }); // molette 3D : zoom seul
  });
  // Aperçu agrandi des captures
  const apercu = document.getElementById("apercu-fenetre")!;
  const apercuImg = document.getElementById("apercu-img") as HTMLImageElement;
  document.querySelectorAll<HTMLImageElement>("img[data-zoom]").forEach((img) => {
    img.addEventListener("click", async () => {
      apercuImg.removeAttribute("style");
      apercuImg.src = img.currentSrc || img.src;
      apercuImg.alt = img.alt;
      await apercuImg.decode().catch(() => {});
      // Seule la largeur est fixée : la hauteur suit le ratio réel de l'image (jamais de bandes)
      const marge = 38; // marge d'écran + bordures
      const barre = 48 + 6 + 32; // barre de titre + bordures + marge
      const ratio = apercuImg.naturalWidth / apercuImg.naturalHeight;
      const maxW = innerWidth - marge;
      apercuImg.style.width = `${ratio ? Math.min(maxW, (innerHeight - barre) * ratio) : maxW}px`;
      apercuImg.style.height = "auto";
      apercu.showPopover();
    });
  });
  // Ouverte = survolée ou épinglée (clic). Un 2e clic dépingle
  document.querySelectorAll<HTMLElement>(".partie").forEach((partie) => {
    let survol = false;
    let epingle = false;
    const maj = () => partie.setAttribute("aria-expanded", String(survol || epingle));
    const basculer = () => {
      epingle = !epingle;
      maj();
    };
    partie.addEventListener("pointerenter", (e) => {
      if (e.pointerType !== "mouse") return; // tactile : le clic gère
      survol = true;
      maj();
    });
    partie.addEventListener("pointerleave", (e) => {
      if (e.pointerType !== "mouse") return;
      survol = false;
      maj();
    });
    partie.addEventListener("click", basculer);
    partie.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        basculer();
      }
    });
  });
  // Carrousel : défilement natif (scroll-snap) + flèches, points et clavier
  document.querySelectorAll<HTMLElement>(".carrousel").forEach((car) => {
    const piste = car.querySelector<HTMLElement>(".carrousel-piste")!;
    const points = [...car.querySelectorAll<HTMLElement>(".carrousel-point")];
    let actuel = 0;
    let fin = 0; // pendant l'animation d'un clic, le défilement ne réécrit pas l'index
    const images = [...piste.querySelectorAll<HTMLImageElement>("img")];
    images.forEach((img) => img.decode().catch(() => {})); // décodées d'avance : pas de fond visible
    const aller = async (i: number) => {
      const n = points.length;
      const cible = (i + n) % n;
      const boucle = Math.abs(cible - actuel) === n - 1 && n > 2; // dernier ↔ premier : saut direct, sans balayage
      actuel = cible; // mémorisé tout de suite : deux clics rapides avancent de deux
      fin = Date.now() + 700;
      await images[cible].decode().catch(() => {}); // image prête avant d'arriver
      piste.scrollTo({ left: cible * piste.clientWidth, behavior: boucle || matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
    };
    const courant = () => actuel;
    piste.addEventListener("scroll", () => {
      const i = Math.min(points.length - 1, Math.max(0, Math.round(piste.scrollLeft / piste.clientWidth)));
      if (Date.now() > fin) actuel = i;
      points.forEach((p, k) => p.setAttribute("aria-current", String(k === i)));
    }, { passive: true });
    car.querySelector(".carrousel-prec")!.addEventListener("click", () => aller(courant() - 1));
    car.querySelector(".carrousel-suiv")!.addEventListener("click", () => aller(courant() + 1));
    points.forEach((p, i) => p.addEventListener("click", () => aller(i)));
    piste.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") { e.preventDefault(); aller(courant() - 1); }
      if (e.key === "ArrowRight") { e.preventDefault(); aller(courant() + 1); }
    });
  });
  if (document.querySelector("model-viewer")) import("@google/model-viewer");
</script>
