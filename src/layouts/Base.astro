---
import "../styles/global.css";
import Menu from "../components/Menu.astro";
import Curseur from "../components/Curseur.astro";
import Contact from "../components/Contact.astro";

interface Props {
  titre: string;
  description: string;
  classeBody?: string;
  // Faux sur l'accueil (pied intégré au contact)
  pied?: boolean;
}

const { titre, description, classeBody = "", pied = true } = Astro.props;
const canonique = new URL(Astro.url.pathname, Astro.site);
const imagePartage = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    <link rel="icon" href="/favicon.ico" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={imagePartage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Adam Gosmat, identités graphiques et 3D" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap.xml" />
    <slot name="head" />

    <!-- Lenis, copié dans public/vendor (pas de node_modules) -->
    <script is:inline defer src="/vendor/lenis.min.js"></script>

    <!-- Couleurs et police des titres tirées au hasard, avant affichage -->
    <script is:inline>
      (() => {
        const accents = ["#ffdb33", "#ff6b6b", "#6ec1ff", "#7ed6a0", "#b9a7ff", "#ff9f43"].sort(() => Math.random() - 0.5);
        const fonds = ["#fffdf4", "#f5f1ff", "#eef7ff", "#effaf2", "#fff4ea", "#fff1f1"];
        const polices = [
          "Audio Nugget",
          "Library 3 AM",
          "Library 3 AM Soft",
          "Lost Wages",
          "Marlboro",
          "Clip",
          "Seaside Resort NF",
          "Souci Sans NF",
          "Akka",
          "Husky Stash",
          "Spicy Sale",
        ];
        const racine = document.documentElement.style;

        accents.forEach((couleur, i) => racine.setProperty(`--color-c${i + 1}`, couleur));
        racine.setProperty("--color-fond", fonds[Math.floor(Math.random() * fonds.length)]);

        const tirer = () => polices[Math.floor(Math.random() * polices.length)];
        const appliquer = (police) => racine.setProperty("--font-titre", `"${police}", "Archivo", sans-serif`);
        appliquer(tirer());

        // Corrections par police (interligne = multiplicateur du leading Tailwind)
        // Husky Stash : ombre qui déborde sous la ligne. Audio Nugget : très plate
        const reglages = {
          "Husky Stash": { espacement: "0.03em", interligne: 1.12 },
          "Audio Nugget": { interligne: 0.8 },
        };

        // Une police par titre, sans doublon ; repli si elle ne charge pas
        async function assignerPolices() {
          const pile = [...polices].sort(() => Math.random() - 0.5);
          const prochaine = () => (pile.length ? pile.shift() : tirer());

          for (const titre of document.querySelectorAll(".font-titre")) {
            let police = prochaine();
            for (let essai = 0; essai < polices.length; essai++) {
              try {
                await document.fonts?.load(`32px "${police}"`);
                if (!document.fonts || document.fonts.check(`32px "${police}"`)) break;
              } catch (e) {}
              police = prochaine();
            }
            titre.style.fontFamily = `"${police}", "Archivo", sans-serif`;
            const reglage = reglages[police];
            if (reglage) {
              const style = getComputedStyle(titre);
              if (reglage.espacement) titre.style.letterSpacing = reglage.espacement;
              if (reglage.interligne) titre.style.lineHeight = String((parseFloat(style.lineHeight) / parseFloat(style.fontSize)) * reglage.interligne);
            }
            // Police large : réduit le titre qui déborde
            if (getComputedStyle(titre).writingMode === "horizontal-tb") {
              let taille = parseFloat(getComputedStyle(titre).fontSize);
              for (let i = 0; i < 8 && titre.scrollWidth > titre.clientWidth + 1; i++) {
                taille *= titre.clientWidth / titre.scrollWidth;
                titre.style.fontSize = `${taille}px`;
              }
            }
          }
        }

        if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", assignerPolices);
        else assignerPolices();
      })();
    </script>
  </head>
  <body class={classeBody}>
    <a href="#contenu" class="etiquette sr-only bg-c1 focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50">Aller au contenu</a>
    <slot />
    {
      pied && (
        <div class="mt-24">
          <Contact />
        </div>
      )
    }
    <Menu />
    <Curseur />
  </body>
</html>

<script>
  // Lenis lisse la molette mais garde window.scrollY (le scroll horizontal en dépend)
  const Lenis = (window as any).Lenis;
  if (Lenis && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    (window as any).lenis = new Lenis({ autoRaf: true, lerp: 0.1, wheelMultiplier: 1 });
  }
</script>
