---
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import CarteEtude from "../components/CarteEtude.astro";
import { etudes, travaux, sansAccents } from "../data/projets";
import blender from "../assets/logos/Blender_logo_no_text.svg";
import illustrator from "../assets/logos/Adobe_Illustrator_CC_icon.svg";
import photoshop from "../assets/logos/Adobe_Photoshop_CC_icon.svg";
import affinity from "../assets/logos/Affinity_App_Logo.svg";
import figma from "../assets/logos/Figma-logo.svg";

const logiciels = ["Blender", "Illustrator", "Photoshop", "After Effects", "Figma"];

const personne = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Adam Gosmat",
  url: "https://adamgosmat.com",
  jobTitle: "Étudiant BUT MMI, design graphique et 3D",
  sameAs: ["https://www.linkedin.com/in/adam-gosmat-98a2902a7/", "https://github.com/3CatSpam"],
};
---

<Base pied={false} titre="Adam Gosmat · Design graphique & 3D" description="Portfolio d'Adam Gosmat, étudiant en BUT MMI : identités visuelles, modélisation et animation 3D.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(personne)} />

  <!-- Écran de chargement AG (CSS uniquement) -->
  <div class="chargeur fixed inset-0 z-50 grid place-items-center bg-fond" aria-hidden="true">
    <div class="boite flex items-center gap-6 bg-white px-10 py-7">
      <span class="ag grid size-14 place-items-center rounded-full border-3 border-encre bg-c2 font-black shadow-dur-sm">AG</span>
      <span class="flex items-center gap-2.5">
        <span class="barre h-11 w-3 rounded-md border-3 border-encre bg-fond shadow-dur-sm"></span>
        <span class="barre h-11 w-3 rounded-md border-3 border-encre bg-fond shadow-dur-sm"></span>
        <span class="barre h-11 w-3 rounded-md border-3 border-encre bg-fond shadow-dur-sm"></span>
      </span>
    </div>
  </div>

  <!-- Sur ordinateur : on scrolle normalement vers le bas, et le <main> (collé à l'écran) avance de gauche à droite.
       #piste est juste une boîte très haute qui crée la longueur de scroll. -->
  <div id="piste">
  <main id="contenu" class="md:sticky md:top-0 md:flex md:h-dvh md:overflow-hidden">
    <!-- 1. Accueil -->
    <section id="accueil" class="flex flex-col gap-5 p-5 pb-24 md:h-full md:w-screen md:shrink-0 md:px-10">
      <header class="flex h-14 items-center justify-between">
        <a href="/#accueil" class="grid size-12 place-items-center rounded-full border-3 border-encre bg-c1 font-black shadow-dur-sm" aria-label="Accueil">AG</a>
        <div class="hidden items-center gap-3 md:flex">
          <span class="etiquette bg-c4">BUT MMI · 2e année</span>
          <span class="etiquette bg-white">Montbéliard</span>
        </div>
      </header>

      <div class="grid flex-1 gap-6 md:grid-cols-[5fr_7fr]">
        <div class="boite relative flex min-h-0 flex-col justify-between gap-5 bg-white p-6">
          <span class="etiquette absolute -top-6 -right-3 rotate-6 bg-c2" style="height:2.9rem;padding:0 1.2rem;font-size:1.05rem;border-width:3px;box-shadow:var(--shadow-dur)">Design graphique &amp; 3D</span>
          <h1 class="font-titre text-[clamp(3.5rem,9vw,8.5rem)] leading-[0.92] uppercase">Adam<br />Gosmat</h1>
          <p class="max-w-[40ch] text-lg font-medium md:text-2xl">
            Je dessine des identités et je modélise des objets en 3D. <span class="brouillon">[Phrase de positionnement : ce que je cherche, pour qui.]</span>
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/#etudes" class="bouton bg-c1">Voir les projets →</a>
            <a href="/#contact" class="bouton bg-white">Me contacter</a>
          </div>
        </div>
        <div class="boite outils relative min-h-0 overflow-hidden bg-c3">
          <!-- Logiciels : tuiles à ombre dure, comme dans la maquette Figma -->
          <!-- Les logiciels tournent en orbite autour du bouton CV (cercle en pointillés) -->
          <div class="orbite">
            <span class="bras" style="--a:-132deg"><span class="tuile" style="background:#001e36"><img src={photoshop.src} alt="Photoshop" class="logo-plein" /></span></span>
            <span class="bras" style="--a:-60deg"><span class="tuile" style="background:#330000"><img src={illustrator.src} alt="Illustrator" class="logo-plein" /></span></span>
            <span class="bras" style="--a:12deg"><span class="tuile" style="background:#a7f175"><img src={affinity.src} alt="Affinity" class="logo-plein" /></span></span>
            <span class="bras" style="--a:84deg"><span class="tuile bg-white"><img src={figma.src} alt="Figma" class="logo-figma" /></span></span>
            <span class="bras" style="--a:156deg"><span class="tuile bg-white"><img src={blender.src} alt="Blender" class="logo-blender" /></span></span>
          </div>
          <a href="/CV_GOSMAT_Adam.pdf" class="bouton bouton-cv bg-white">CV (PDF) ↓</a>
        </div>
      </div>
    </section>

    <!-- 2. Bande de logiciels -->
    <div class="overflow-hidden border-y-3 border-encre bg-c1 md:h-full md:w-24 md:shrink-0 md:border-x-3 md:border-y-0" aria-hidden="true">
      <div class="bande flex w-max md:w-auto md:flex-col">
        {
          [...logiciels, ...logiciels].map((nom) => (
            <span class="px-4 py-4 text-2xl font-black whitespace-nowrap md:rotate-180 uppercase md:mx-auto md:px-0 md:[writing-mode:vertical-rl]">{nom} ✦</span>
          ))
        }
      </div>
    </div>

    <!-- 3. À propos -->
    <section id="a-propos" class="flex items-center gap-8 px-5 py-20 max-md:flex-col max-md:items-start md:h-full md:w-[min(1150px,92vw)] md:shrink-0 md:px-14">
<div class="flex flex-col items-start gap-5">
        <span class="etiquette bg-c4">À propos</span>
        <p data-surligne class="text-[clamp(2rem,4.2vw,4rem)] leading-[1.1] font-bold tracking-tight">
        Salut, moi c'est Adam. Je passe d'Illustrator à Blender sans changer de cerveau : une identité, un objet, un rendu, tout part d'un croquis et d'une raison d'exister. Voici trois projets que j'ai poussés jusqu'au bout.
      </p>
      </div>
    </section>

    <!-- 4. Projets (ils s'empilent en défilant) -->
    <section id="etudes" class="flex flex-col gap-9 px-5 py-10 md:h-full md:shrink-0 md:flex-row md:items-center md:pl-10">
      <h2 class="relative z-10 font-titre text-[clamp(2.8rem,5vw,4.8rem)] leading-[0.95] uppercase md:w-auto md:shrink-0 md:rotate-180 md:text-[7.5rem] md:[writing-mode:vertical-rl]">Projets</h2>
      {etudes.map((etude, index) => <CarteEtude etude={etude} index={index} />)}
      <!-- Petite pause avant que la pile reparte (le sticky s'arrête au bout de la section) -->
      <div class="h-10 shrink-0 md:h-auto md:w-10" aria-hidden="true"></div>
    </section>

    <!-- 5. Autres travaux -->
    <section id="travaux" class="flex flex-col justify-center gap-6 border-b-3 border-encre px-5 py-16 md:h-full md:w-[min(1240px,94vw)] md:shrink-0 md:border-r-3 md:border-b-0 md:px-10">
      <h2 class="font-titre text-[clamp(2.8rem,5vw,4.8rem)] leading-[0.95] uppercase">Autres travaux</h2>
      <ul id="liste-travaux" class="boite divide-y-2 divide-encre bg-white">
        {
          travaux.map((travail) => (
            <li data-apercu={encodeURI(travail.imageMini)} class={`relative grid grid-cols-[4.5rem_1fr_auto] items-center gap-4 p-2.5 pr-5 first:rounded-t-[7px] last:rounded-b-[7px] md:grid-cols-[4.5rem_1.3fr_1fr_auto] ${travail.couleur}`}>
              <img src={encodeURI(travail.imageMini)} alt="" loading="lazy" decoding="async" class="aspect-square w-full rounded-md border-2 border-encre bg-fond object-cover" />
              {travail.lien ? (
                <a href={travail.lien} target="_blank" rel="noopener" class="text-xl font-bold underline-offset-4 after:absolute after:inset-0 after:content-[''] hover:underline md:text-2xl">{travail.titre} ↗</a>
              ) : (
                <a href={`/projets/${travail.slug}/`} class="text-xl font-bold underline-offset-4 after:absolute after:inset-0 after:content-[''] hover:underline md:text-2xl">{travail.titre} →</a>
              )}
              <span class="hidden font-mono text-sm uppercase md:block">{travail.categorie}</span>
              <span class="font-mono text-sm">{travail.annee}</span>
            </li>
          ))
        }
      </ul>

      <!-- Popup d'aperçu qui suit la souris quand on survole une ligne (souris fine uniquement) -->
      <div id="apercu-travail" class="boite pointer-events-none fixed top-0 left-0 z-40 hidden w-56 origin-top-left scale-90 overflow-hidden bg-white opacity-0 transition-[scale,opacity] duration-150 ease-out will-change-transform" aria-hidden="true">
        <img class="aspect-square w-full object-cover" alt="" decoding="async" />
      </div>
    </section>

    <!-- 6. Contact : le fond change de couleur tout seul -->
    <!-- Exactement un écran : 100dvh de haut (et 100vw de large sur ordinateur) -->
    <section id="contact" class="flex min-h-dvh flex-col justify-between gap-[clamp(0.75rem,2.5vh,1.5rem)] md:h-dvh md:min-h-0 md:overflow-hidden border-encre px-5 pt-6 pb-24 transition-colors duration-[1500ms] md:w-screen md:shrink-0 md:px-10">
      <div class="flex items-center justify-between gap-3">
        <span class="etiquette bg-white">Contact</span>
        <div id="pastilles" class="flex items-center gap-2.5" role="group" aria-label="Couleur du fond"></div>
      </div>

      <!-- La taille dépend aussi de la hauteur d'écran (vh) pour que tout tienne dans un écran -->
      <h2 class="font-titre text-[clamp(2.5rem,min(7.5vw,12vh),8rem)] leading-[0.9] uppercase">On fabrique un truc ?</h2>

      <!-- Le formulaire ouvre la messagerie du visiteur : aucune donnée n'est stockée par le site -->
      <form id="formulaire" action="mailto:contact@adamgosmat.com" method="post" enctype="text/plain" class="boite grid max-w-4xl gap-3 bg-white p-5 md:grid-cols-2">
        <label class="flex flex-col gap-1.5 font-mono text-xs uppercase">
          Nom
          <input name="nom" autocomplete="name" required class="rounded-lg border-3 border-encre bg-fond px-3 py-2.5 font-texte text-base normal-case" />
        </label>
        <label class="flex flex-col gap-1.5 font-mono text-xs uppercase">
          E-mail
          <input name="email" type="email" autocomplete="email" required class="rounded-lg border-3 border-encre bg-fond px-3 py-2.5 font-texte text-base normal-case" />
        </label>
        <label class="flex flex-col gap-1.5 font-mono text-xs uppercase md:col-span-2">
          Message
          <textarea name="message" rows="2" required class="rounded-lg border-3 border-encre bg-fond px-3 py-2.5 font-texte text-base normal-case"></textarea>
        </label>
        <p class="text-sm md:col-span-2">
          En envoyant, ta messagerie s'ouvre avec le message prêt. Détails dans la <a href="/confidentialite/" class="underline">politique de confidentialité</a>.
        </p>
        <button type="submit" class="bouton justify-self-start bg-c1">Envoyer →</button>
      </form>

      <div class="flex flex-wrap items-center justify-between gap-3">
        <ul class="flex flex-wrap items-center gap-3">
          <li><a href="mailto:contact@adamgosmat.com" class="etiquette bg-white normal-case">contact@adamgosmat.com</a></li>
          <li><a href="https://www.linkedin.com/in/adam-gosmat-98a2902a7/" class="etiquette bg-white">LinkedIn</a></li>
          <li><a href="https://github.com/3CatSpam" class="etiquette bg-white">GitHub</a></li>
          <li><a href="/CV_GOSMAT_Adam.pdf" class="etiquette bg-white">CV (PDF)</a></li>
        </ul>
        <Footer />
      </div>
    </section>
  </main>
  </div>
</Base>

<script>
  const ordinateur = matchMedia("(min-width: 48rem)");
  const defilement = document.querySelector<HTMLElement>("#contenu")!;

  // --- 1. Scroll vertical → défilement de gauche à droite (sur ordinateur) ---
  // Le <main> est collé à l'écran (sticky). On donne à #piste la hauteur nécessaire,
  // puis on recopie le scroll vertical de la page dans le scroll horizontal du <main>.
  // Comme le <main> défile vraiment (scrollLeft), les cartes en "sticky left" s'empilent toutes seules.
  const piste = document.querySelector<HTMLElement>("#piste")!;

  function mesurer() {
    piste.style.height = ordinateur.matches ? `${defilement.scrollWidth - innerWidth + innerHeight}px` : "";
    suivreScroll();
  }

  function suivreScroll() {
    if (ordinateur.matches) defilement.scrollLeft = window.scrollY;
  }

  window.addEventListener("scroll", suivreScroll, { passive: true });
  window.addEventListener("resize", mesurer);
  window.addEventListener("load", mesurer); // une fois les images et polices chargées
  mesurer();

  // Liens du menu (/#etudes…) : sur ordinateur, on scrolle la page jusqu'à la position horizontale de la section
  function allerA(id: string, douceur: ScrollBehavior) {
    const cible = document.getElementById(id);
    if (!cible) return;
    const lenis = (window as any).lenis; // défilement doux (absent si "moins de mouvement")
    const immediat = douceur === "instant";
    if (ordinateur.matches) {
      if (lenis) lenis.scrollTo(cible.offsetLeft, { immediate: immediat });
      else window.scrollTo({ top: cible.offsetLeft, behavior: douceur });
    } else if (lenis) lenis.scrollTo(cible, { immediate: immediat });
    else cible.scrollIntoView({ behavior: douceur });
  }

  document.querySelectorAll<HTMLAnchorElement>('a[href^="/#"]').forEach((lien) => {
    lien.addEventListener("click", (e) => {
      e.preventDefault();
      const id = lien.hash.slice(1);
      history.replaceState(null, "", `#${id}`);
      allerA(id, "smooth");
    });
  });
  if (location.hash) window.addEventListener("load", () => allerA(location.hash.slice(1), "instant"));

  // --- 1 bis. Orbite des logos : la vitesse ralentit / repart en douceur au survol (au lieu d'un arrêt net) ---
  const zoneOutils = document.querySelector<HTMLElement>(".outils");
  if (zoneOutils && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const animations = () => zoneOutils.getAnimations({ subtree: true }).filter((a) => a instanceof CSSAnimation);
    let cible = 1;
    let vitesse = 1;
    let minuteur: ReturnType<typeof setInterval> | undefined;
    let dernier = 0;
    const pas = () => {
      // lissage exponentiel indépendant de la fréquence d'images : ~0,2 s pour parcourir les 2/3 du chemin
      const maintenant = performance.now();
      const dt = Math.min(maintenant - dernier, 100) / 1000;
      dernier = maintenant;
      vitesse += (cible - vitesse) * (1 - Math.exp(-dt / 0.2));
      if (Math.abs(cible - vitesse) < 0.003) vitesse = cible;
      animations().forEach((a) => (a.playbackRate = vitesse));
      if (vitesse === cible) {
        clearInterval(minuteur);
        minuteur = undefined;
      }
    };
    const aller = (valeur: number) => {
      cible = valeur;
      if (!minuteur) {
        dernier = performance.now();
        minuteur = setInterval(pas, 16);
      }
    };
    zoneOutils.addEventListener("mouseenter", () => aller(0));
    zoneOutils.addEventListener("mouseleave", () => aller(1));
  }

  // --- 2. Texte « À propos » qui s'allume mot par mot ---
  const texte = document.querySelector<HTMLElement>("[data-surligne]")!;
  const mots = texte.textContent!.trim().split(/\s+/);
  texte.innerHTML = mots.map((mot) => `<span>${mot}</span>`).join(" ");
  const spans = texte.querySelectorAll("span");

  function allumerMots() {
    const r = texte.getBoundingClientRect();
    // 0 quand le texte arrive aux 3/4 de l'écran, 1 quand sa fin y arrive
    const progression = ordinateur.matches ? (innerWidth * 0.75 - r.left) / r.width : (innerHeight * 0.75 - r.top) / r.height;
    const nombre = Math.round(Math.min(1, Math.max(0, progression)) * mots.length);
    spans.forEach((span, i) => span.classList.toggle("allume", i < nombre));
  }
  window.addEventListener("scroll", allumerMots, { passive: true });
  allumerMots();

  // --- 3. Contact : couleurs dans un ordre aléatoire, changement lent toutes les 12 s ---
  const couleurs = ["bg-c1", "bg-c2", "bg-c3", "bg-c4", "bg-c5", "bg-c6"].sort(() => Math.random() - 0.5);
  const contact = document.querySelector<HTMLElement>("#contact")!;
  const pastilles = document.querySelector<HTMLElement>("#pastilles")!;
  let actuelle = 0;

  function choisirCouleur(i: number) {
    contact.classList.remove(couleurs[actuelle]);
    actuelle = i;
    contact.classList.add(couleurs[actuelle]);
    pastilles.querySelectorAll("button").forEach((b, k) => b.setAttribute("aria-pressed", String(k === i)));
  }

  couleurs.forEach((couleur, i) => {
    const bouton = document.createElement("button");
    bouton.className = `size-8 rounded-md border-2 border-encre shadow-dur-sm aria-pressed:translate-0.5 aria-pressed:shadow-none ${couleur}`;
    bouton.setAttribute("aria-label", `Fond ${couleur.replace("bg-", "")}`);
    bouton.addEventListener("click", () => choisirCouleur(i));
    pastilles.append(bouton);
  });

  choisirCouleur(0);
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    setInterval(() => choisirCouleur((actuelle + 1) % couleurs.length), 12000);
  }

  // --- 4. Formulaire : prépare un e-mail propre dans la messagerie du visiteur ---
  const formulaire = document.querySelector<HTMLFormElement>("#formulaire")!;
  formulaire.addEventListener("submit", (e) => {
    e.preventDefault();
    const donnees = new FormData(formulaire);
    const sujet = `Portfolio · message de ${donnees.get("nom")}`;
    const corps = `${donnees.get("message")}\n\n${donnees.get("nom")} · ${donnees.get("email")}`;
    location.href = `mailto:contact@adamgosmat.com?subject=${encodeURIComponent(sujet)}&body=${encodeURIComponent(corps)}`;
  });

  // --- 5. Autres travaux : popup d'aperçu qui suit la souris au survol (souris fine uniquement) ---
  const listeTravaux = document.querySelector<HTMLElement>("#liste-travaux");
  const apercu = document.querySelector<HTMLElement>("#apercu-travail");
  const apercuImg = apercu?.querySelector("img");

  if (listeTravaux && apercu && apercuImg && matchMedia("(pointer: fine)").matches) {
    let masquageMinuteur: ReturnType<typeof setTimeout> | undefined;
    let chargeMinuteur: ReturnType<typeof setTimeout> | undefined;
    let cibleX = 0;
    let cibleY = 0;
    let posX = 0;
    let posY = 0;
    let visible = false;
    let boucleActive = false;

    // Une seule écriture de position par frame (au lieu d'une par mousemove), et la position
    // "rattrape" doucement la souris plutôt que de lui téléporter dessus : ça lisse le suivi
    // et ça retire tout le travail de style qui n'a pas besoin d'être fait entre deux frames.
    function boucle() {
      posX += (cibleX - posX) * 0.25;
      posY += (cibleY - posY) * 0.25;
      apercu.style.translate = `${posX}px ${posY}px`;
      if (visible && (Math.abs(cibleX - posX) > 0.5 || Math.abs(cibleY - posY) > 0.5)) {
        requestAnimationFrame(boucle);
      } else {
        boucleActive = false;
      }
    }

    function demarrerBoucle() {
      if (!boucleActive) {
        boucleActive = true;
        requestAnimationFrame(boucle);
      }
    }

    // mouseleave est posé sur la LISTE entière, pas sur chaque <li> : passer d'une ligne à la
    // suivante ne doit pas déclencher de sortie — sinon chaque changement de ligne relançait un
    // fondu de sortie aussitôt annulé par le fondu d'entrée suivant, ce qui saccadait tout
    // (particulièrement visible sur WebKit, qui gère mal une transition CSS interrompue en boucle).
    listeTravaux.addEventListener("mouseleave", () => {
      clearTimeout(chargeMinuteur); // la souris est repartie avant la fin du délai : on annule le chargement prévu
      visible = false;
      apercu.classList.add("opacity-0", "scale-90");
      masquageMinuteur = setTimeout(() => apercu.classList.add("hidden"), 150);
    });

    listeTravaux.querySelectorAll<HTMLElement>("li[data-apercu]").forEach((ligne) => {
      ligne.addEventListener("mouseenter", (e) => {
        clearTimeout(masquageMinuteur); // annule un masquage programmé par la ligne précédente (ou la liste) qui précède
        cibleX = e.clientX + 24;
        cibleY = e.clientY - 96;
        demarrerBoucle();

        // On attend un court instant avant de charger l'image de CETTE ligne : en descendant
        // vite dans la liste, chaque survol est annulé par le suivant avant d'avoir eu le temps
        // de charger quoi que ce soit — on ne déclenche donc plus rien tant que la souris ne
        // s'arrête pas un minimum sur une ligne.
        clearTimeout(chargeMinuteur);
        chargeMinuteur = setTimeout(() => {
          apercuImg.src = ligne.dataset.apercu!;
          if (!visible) {
            // Première apparition : pas de trajet à rattraper, on part direct de la souris.
            posX = cibleX;
            posY = cibleY;
            apercu.style.translate = `${posX}px ${posY}px`;
          }
          visible = true;
          apercu.classList.remove("hidden");
          requestAnimationFrame(() => apercu.classList.remove("opacity-0", "scale-90"));
        }, 100);
      });
      ligne.addEventListener("mousemove", (e) => {
        cibleX = e.clientX + 24;
        cibleY = e.clientY - 96;
        demarrerBoucle();
      });
    });
  }
</script>
