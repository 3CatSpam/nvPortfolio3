---
import Base from "../layouts/Base.astro";

const phrases = ["Page introuvable", "Erreur 404", "Signal perdu", "Rien à voir ici", "Demi-tour"];
---

<Base titre="Page introuvable · Adam Gosmat" description="Cette page n'existe pas ou a été déplacée.">
  <meta slot="head" name="robots" content="noindex" />

  <main id="contenu" class="relative grid min-h-dvh place-items-center overflow-hidden px-5 pt-16 pb-44">
    <!-- Décor : pois, étoile, rond et carré qui tournent doucement -->
    <span class="deco deco--etoile bg-c3" aria-hidden="true"></span>
    <span class="deco deco--rond boite bg-c4" aria-hidden="true"></span>
    <span class="deco deco--carre boite bg-c5" aria-hidden="true"></span>

    <div class="relative flex w-full max-w-2xl flex-col items-center gap-7 text-center">
      <p class="etiquette -rotate-2 bg-c2">Erreur 404 · Signal perdu</p>

      <!-- Les trois chiffres : celui du milieu est un anneau qui tourne -->
      <div class="chiffres" aria-hidden="true">
        <span class="chiffre boite font-titre bg-c1" style="--tilt: -6deg">4</span>
        <span class="chiffre chiffre--rond boite font-titre bg-c2" style="--tilt: 4deg">0</span>
        <span class="chiffre boite font-titre bg-c3" style="--tilt: -3deg">4</span>
      </div>

      <div class="flex flex-col gap-3">
        <h1 class="font-titre text-4xl leading-none uppercase sm:text-6xl">Page introuvable</h1>
        <p class="mx-auto max-w-md">
          Cette page n'existe pas, a été déplacée, ou s'est perdue entre deux pixels.
        </p>
      </div>

      <!-- Faux terminal : le journal de la recherche apparaît ligne par ligne -->
      <div class="boite log w-full max-w-md bg-white p-4 text-left font-mono text-sm">
        <p style="--i: 0">&gt; requête : <span data-chemin>/page-inconnue</span></p>
        <p style="--i: 1">&gt; recherche en cours<span class="clignote">…</span></p>
        <p style="--i: 2" class="font-bold">✕ résultat : 0 page trouvée</p>
        <p style="--i: 3">&gt; conseil : retourner à l'accueil <span class="clignote">▍</span></p>
      </div>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="/" class="bouton bg-c1">Retour à l'accueil</a>
        <button type="button" class="bouton bg-white" data-retour>Page précédente</button>
      </div>
    </div>

    <!-- Bandeau qui défile, légèrement penché -->
    <div class="bande-404" aria-hidden="true">
      <div class="piste">
        {
          [0, 1].map(() => (
            <div class="groupe">
              {[...phrases, ...phrases].map((phrase) => (
                <span>{phrase} ✶</span>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </main>
</Base>

<style>
  main {
    background-image: radial-gradient(color-mix(in srgb, var(--color-encre) 16%, transparent) 1.5px, transparent 1.5px);
    background-size: 22px 22px;
  }

  /* Chiffres */
  .chiffres {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.6rem, 3vw, 1.5rem);
  }
  .chiffre {
    display: grid;
    place-items: center;
    width: clamp(6.5rem, 26vw, 12rem);
    aspect-ratio: 1;
    font-size: clamp(4.5rem, 20vw, 9.5rem);
    line-height: 1;
    rotate: var(--tilt);
    animation: flotte 3.2s ease-in-out infinite;
    transition: rotate 0.3s cubic-bezier(0.3, 1.6, 0.5, 1), scale 0.3s;
  }
  .chiffre:nth-child(2) {
    animation-delay: -1.1s;
  }
  .chiffre:nth-child(3) {
    animation-delay: -2.2s;
  }
  .chiffre:hover {
    rotate: 0deg;
    scale: 1.06;
  }
  .chiffre--rond {
    border-radius: 50%;
    position: relative;
  }
  .chiffre--rond::before {
    content: "";
    position: absolute;
    inset: -16px;
    border: 3px dashed var(--color-encre);
    border-radius: 50%;
    animation: tourne 9s linear infinite;
  }
  @keyframes flotte {
    50% {
      translate: 0 -12px;
    }
  }
  @keyframes tourne {
    to {
      rotate: 360deg;
    }
  }

  /* Décor */
  .deco {
    position: absolute;
    width: clamp(2.5rem, 7vw, 4.5rem);
    aspect-ratio: 1;
    pointer-events: none;
    animation: tourne 14s linear infinite;
  }
  .deco--etoile {
    top: 12%;
    left: 8%;
    clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
  }
  .deco--rond {
    top: 20%;
    right: 9%;
    border-radius: 50%;
    animation-duration: 18s;
    animation-direction: reverse;
  }
  .deco--carre {
    bottom: 28%;
    left: 12%;
    animation-duration: 11s;
  }

  /* Journal */
  .log p {
    opacity: 0;
    animation: apparait 0.3s ease forwards;
    animation-delay: calc(var(--i) * 0.45s + 0.4s);
  }
  @keyframes apparait {
    to {
      opacity: 1;
    }
  }
  .clignote {
    animation: clignote 1s steps(2) infinite;
  }
  @keyframes clignote {
    to {
      visibility: hidden;
    }
  }

  /* Boutons (le bouton "Page précédente" est un <button>) */
  button.bouton {
    font-family: inherit;
    font-size: 1rem;
    cursor: pointer;
  }

  /* Bandeau */
  .bande-404 {
    position: absolute;
    left: -5%;
    right: -5%;
    bottom: 2.5rem;
    rotate: -2deg;
    overflow: hidden;
    padding: 0.6rem 0;
    border-block: 3px solid var(--color-encre);
    background: var(--color-c1);
    box-shadow: var(--shadow-dur-sm);
  }
  .piste {
    display: flex;
    width: max-content;
    animation: defile 20s linear infinite;
  }
  .groupe {
    display: flex;
  }
  .groupe span {
    padding-inline: 1rem;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    white-space: nowrap;
  }
  @keyframes defile {
    to {
      translate: -50% 0;
    }
  }
</style>

<script>
  // Affiche le chemin demandé dans le journal, et fait fonctionner « Page précédente »
  try {
    const chemin = document.querySelector("[data-chemin]");
    if (chemin) chemin.textContent = location.pathname.slice(0, 40);
  } catch (e) {}

  document.querySelector("[data-retour]")?.addEventListener("click", () => {
    if (history.length > 1) history.back();
    else location.href = "/";
  });
</script>
